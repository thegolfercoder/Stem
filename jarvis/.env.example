# Copy to `.env` in this directory and fill in. `.env` is gitignored: it holds
# the one secret JARVIS has, and a key in the repository is a key on the internet
# the first time the repository leaves this machine.

# The cloud model's API key. Read from the environment only - never stored in the
# database and never written by the settings page, so the key cannot leak through
# a backup of `data/`. `ANTHROPIC_API_KEY` is also accepted, since the Anthropic
# SDK and other tools already use that name.
JARVIS_ANTHROPIC_API_KEY=

# Optional, and only for voice. Without it voice still works through the
# browser's own speech engine, which is free and keeps the audio in the page.
# With it you can choose Gemini for hearing, for speaking, or for both - more
# accurate, better voices, works in Firefox, and the audio is sent to Google.
# Held to the same rule as the key above: environment only, never the database.
# Get one at https://aistudio.google.com/apikey
# `GEMINI_API_KEY` and `GOOGLE_API_KEY` are also accepted.
# JARVIS_GEMINI_API_KEY=

# Where persistent data lives. Defaults to `jarvis/data/` next to this file.
# Point it at an encrypted volume if you want the database at rest encrypted.
# JARVIS_DATA_DIR=/home/you/.local/share/jarvis

# The address the server binds to. The default is loopback on purpose: JARVIS
# holds every note, task and conversation you give it, and binding to 0.0.0.0
# publishes that to your whole network. Change it only if you know why.
# JARVIS_HOST=127.0.0.1
# JARVIS_PORT=8765

# How long a login lasts before it has to be re-entered.
# JARVIS_SESSION_TTL_HOURS=72
