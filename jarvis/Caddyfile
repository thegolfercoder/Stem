# Replace with your own domain. Caddy gets and renews the certificate itself,
# which is the whole reason it is here rather than nginx: one line, no cron job,
# and no chance of the certificate quietly expiring on a personal project.
#
# For a first try without a domain, use:  localhost
jarvis.example.com {
	encode zstd gzip

	# The app decides its cookie's `secure` flag from this header, so it has to
	# be honest. Caddy sets it correctly by default; it is named here so that
	# anyone swapping Caddy for something else knows it is load-bearing.
	reverse_proxy jarvis:8765 {
		header_up X-Forwarded-Proto {scheme}
	}

	header {
		# This is a personal assistant, not a site anyone should be framing,
		# sniffing or linking into.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
}
