# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Editors
.vscode/
.idea/
.DS_Store

# Research output. Every artefact here is reproducible from a config plus the
# data it names, so none of it belongs in the repository. `results/` is where
# the CLI writes equity curves, trade logs and charts.
results/
out/

# Market data. `data/sample/` is the one exception and is checked in on
# purpose: it is generated by `tradelab generate` from a fixed seed and is small.
# Everything else under data/ is either licensed, large, or both.
data/*
!data/README.md
!data/sample/
!data/sample/*.csv

# Notebook output. The notebooks in this repository are checked in without
# executed cells, so a diff shows the change to the code rather than to a
# base64 image that happens to have rendered differently.
notebooks/**/*.nbconvert.ipynb
